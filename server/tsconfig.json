{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "../build-server",
    "rootDir": "..",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../shared/**/*.ts", "../prisma/seed.ts", "../prisma.config.ts"],
  "exclude": ["../**/*.test.ts", "../**/*.test.tsx"]
}
